{
  "name": "zephyr-devshell-4.4.1",
  "dockerComposeFile": [
    "../../zephyr-docker/docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "dev",
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "${localWorkspaceFolder}/.devcontainer/denver.sh run ${localWorkspaceFolder} --until docker -- echo Done",
  "overrideCommand": true,
  "postStartCommand": "fixuid -q forward-docker-socket.sh",
  "postAttachCommand": "${localWorkspaceFolder}/.devcontainer/refresh-env.sh",
  "shutdownAction": "stopCompose"
}
